# THOS backend configuration. Copy to .env and edit; never commit .env.
# Every variable uses the THOS_ prefix. Unset optional integrations stay disabled
# and return safe "not configured" responses instead of failing at startup.

# --- application ---------------------------------------------------------
# One of: development | test | staging | production
THOS_ENVIRONMENT=development
THOS_DEBUG=false

# Comma-separated allowlist. Wildcard (*) is rejected outside development.
THOS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- persistence and demo data -------------------------------------------
# PostgreSQL is the default for local development (see infrastructure/local/docker-compose.yml).
# Start it with: docker compose -f infrastructure/local/docker-compose.yml up -d
THOS_DATABASE_URL=postgresql://thos:thos@localhost:5432/thos
# SQLite fallback used only when THOS_DATABASE_URL is unset (e.g. unit tests).
# THOS_DATABASE_PATH=./data/thos.db
# Seed demo organizations, personas, jobs, and applications when the
# database is empty (development/test only).
THOS_SEED_DEMO_DATA=true
# Folder containing domain pack manifests (relative to Backend/).
THOS_DOMAIN_PACKS_PATH=../domain-packs

# --- development identity -------------------------------------------------
# Fallback identity when no X-Development-Identity header is sent.
# Ignored in staging/production, where real authentication is required.
THOS_DEVELOPMENT_IDENTITY=local-developer

# --- interview policy -----------------------------------------------------
THOS_PROFILE_INTERVIEW_ATTEMPT_CAP=3
THOS_PROFILE_INTERVIEW_COOLDOWN_HOURS=24

# --- auth -----------------------------------------------------------------
# HS256 signing secret — use a long random value in non-local environments.
THOS_JWT_SECRET=thos-dev-jwt-secret-change-me-now-32b
THOS_JWT_ACCESS_TTL_SECONDS=900
THOS_JWT_REFRESH_TTL_SECONDS=1209600
# Comma-separated emails that receive platform superadmin on register/seed.
THOS_SUPERADMIN_EMAILS=superadmin@thos.local
# Development only: auto-verify organization applications.
THOS_AUTO_VERIFY_ORGANIZATIONS=false

# --- SMTP (stage progression, acceptance and rejection emails) ----------
# Leave THOS_SMTP_HOST empty to log outbound mail to the console instead.
THOS_SMTP_HOST=
THOS_SMTP_PORT=587
THOS_SMTP_USER=
THOS_SMTP_PASSWORD=
THOS_SMTP_FROM_EMAIL=noreply@thos.local
# Public URL of the candidate portal, used for links in outbound emails.
THOS_PUBLIC_BASE_URL=http://localhost:3000
# Local directory for user profile photos (PFP) used in identity checks.
THOS_AVATARS_DIR=./data/avatars

# --- LiveKit (required for Profile Screening / Job Interview voice rooms) -
# Get these from your LiveKit Cloud project or self-hosted deployment.
THOS_LIVEKIT_URL=
THOS_LIVEKIT_API_KEY=
THOS_LIVEKIT_API_SECRET=
THOS_LIVEKIT_TOKEN_TTL_SECONDS=900

# --- AI (required for voice interviews + optional question generation) ----
# Voice interviews need an OpenAI key for STT/TTS, turn assessment, plan
# generation, and post-session analysis.
# Without a key, voice start returns 503 with a clear configuration error.
THOS_AI_PROVIDER=openai
THOS_AI_API_KEY=
THOS_AI_MODEL=gpt-4o-mini
THOS_EMBEDDING_MODEL=text-embedding-3-small
THOS_AI_TIMEOUT_SECONDS=30

# Voice interview runtime (LiveKit Agents pipeline: Silero VAD -> OpenAI STT
# -> LangGraph turn engine -> OpenAI TTS)
THOS_VOICE_INTERVIEW_ENABLED=true
THOS_STT_MODEL=gpt-4o-mini-transcribe
THOS_TTS_MODEL=gpt-4o-mini-tts
THOS_TTS_VOICE=sage
THOS_TURN_ASSESSMENT_MODEL=gpt-4o-mini
THOS_TURN_ASSESSMENT_MAX_TOKENS=200
THOS_ENDPOINTING_DELAY_SECONDS=0.3
THOS_VAD_MIN_SILENCE_SECONDS=0.45
THOS_ANSWER_MAX_WORDS_FOLLOWUP_THRESHOLD=12
THOS_PLAN_GENERATION_MODEL=gpt-4o
THOS_DEFAULT_INTERVIEW_LANGUAGE=English
THOS_DEFAULT_INTERVIEW_LENGTH_MINUTES=10
THOS_ANALYSIS_MODEL=gpt-4o
THOS_RECORDINGS_DIR=./data/recordings
THOS_VIDEOS_DIR=./data/videos
