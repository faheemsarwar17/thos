# THOS frontend configuration. Copy to .env.local and edit; never commit .env.local.

# Base URL of the THOS backend, used by the browser API client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: backend base URL for the LiveKit interview token proxy
# (app/api/interviews/token). Defaults to BACKEND_API_URL below when set.
BACKEND_API_URL=http://localhost:8000

# Server-only: optional override of the backend token endpoint path.
# BACKEND_LIVEKIT_TOKEN_PATH=/api/v1/interviews/token
